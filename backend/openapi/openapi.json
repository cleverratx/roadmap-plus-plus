  "components": {
    "schemas": {
      "CreateItemRequest": {
        "required": [
          "workspaceId",
          "parentId",
          "kind",
          "title",
          "startDate",
          "endDate",
          "descriptionMd"
        ],
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "title": {
            "type": "string"
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "descriptionMd": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateWorkspaceRequest": {
        "required": [
          "name",
          "color"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "InvitationPreview": {
        "required": [
          "workspaceId",
          "workspaceName",
          "color",
          "memberCount",
          "alreadyMember"
        ],
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceName": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "memberCount": {
            "type": "integer",
            "format": "int32"
          },
          "alreadyMember": {
            "type": "boolean"
          }
        }
      },
      "InvitationResponse": {
        "required": [
          "token",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InvitationState": {
        "required": [
          "active"
        ],
        "type": "object",
        "properties": {
          "active": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InvitationResponse"
              }
            ]
          }
        }
      },
      "ItemDetails": {
        "required": [
          "item",
          "descriptionMd",
          "path",
          "children"
        ],
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/ItemResponse"
          },
          "descriptionMd": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            }
          }
        }
      },
      "ItemKind": {
        "enum": [
          "macro",
          "event",
          "group",
          "task"
        ]
      },
      "ItemResponse": {
        "required": [
          "id",
          "workspaceId",
          "parentId",
          "kind",
          "title",
          "startDate",
          "endDate",
          "position"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "title": {
            "type": "string"
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MemberResponse": {
        "required": [
          "userId",
          "displayName",
          "email",
          "color",
          "isHead",
